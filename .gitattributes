# Set default behavior: auto-detect text files and normalize to LF line endings
* text=auto eol=lf

# Source code files (strictly LF across all platforms)
*.rs text eol=lf
*.py text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.go text eol=lf
*.java text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.d.ts text eol=lf

# Config, Markup and Data files
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.xsd text eol=lf
*.txt text eol=lf
*.lock text eol=lf

# Shell scripts (must be LF or Linux execution will break with '\r' syntax errors)
*.sh text eol=lf

# Windows-specific batch scripts (require CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (prevent Git from modifying or converting)
*.pyd binary
*.so binary
*.dylib binary
*.dll binary
*.node binary
*.wasm binary
*.exe binary
*.a binary
*.lib binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

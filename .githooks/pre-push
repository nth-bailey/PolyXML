#!/bin/sh
set -e

if [ -n "$USERPROFILE" ]; then
    export PATH="$USERPROFILE/.rustup/toolchains/stable-x86_64-pc-windows-msvc/bin:$USERPROFILE/.cargo/bin:$PATH"
fi
if [ -n "$HOME" ]; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}[git-hook: pre-push]${NC} Running pre-push verification checks..."

# 1. Version Parity Check
if command -v uv >/dev/null 2>&1; then
    uv run python scripts/sync_version.py --check || exit 1
elif command -v python3 >/dev/null 2>&1; then
    python3 scripts/sync_version.py --check || exit 1
fi

# 2. Rust Workspace Compile Check (if toolchain present)
if command -v cargo >/dev/null 2>&1; then
    echo -e "${BLUE}Running cargo check on workspace...${NC}"
    cargo check --workspace --tests || {
        echo -e "${YELLOW}[WARN] Cargo check failed locally; ensuring full build in CI.${NC}"
    }
fi

echo -e "${GREEN}[SUCCESS] Ready to push to remote!${NC}"
exit 0
